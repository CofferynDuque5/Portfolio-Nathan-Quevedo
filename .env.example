# ==========================================================
#  Portfolio Nathan Quevedo - Variables de entorno
#  Copia este archivo como `.env` y ajusta los valores.
# ==========================================================

# --- Base de datos (MySQL) ---
# Formato: mysql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS
# En cPanel crea la BD y el usuario en "MySQL Databases" y ponlos aquí.
DATABASE_URL="mysql://usuario:contrasena@localhost:3306/nombre_basedatos"

# --- Puerto ---
# En cPanel/Passenger el hosting asigna el puerto automáticamente; puedes
# dejarlo así. En un VPS es el puerto en el que escuchará la app.
PORT=3000
NODE_ENV=production

# --- Seguridad / Autenticación ---
# CAMBIA obligatoriamente esta clave por una larga y aleatoria.
JWT_SECRET="pon-aqui-una-clave-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"

# --- Administrador inicial (creado por el seed) ---
ADMIN_NAME="Nathan Quevedo"
ADMIN_EMAIL="admin@nathanquevedo.com"
ADMIN_PASSWORD="Admin1234!"

# --- Subida de archivos ---
# Déjalo vacío para usar la carpeta por defecto (web/public/uploads).
# Solo defínelo si quieres una ruta ABSOLUTA distinta.
UPLOAD_DIR=""
MAX_UPLOAD_MB=15

# ==========================================================
#  URLs del sitio
# ==========================================================
# Dominio público real de tu sitio (para SEO, sitemap y Open Graph).
NEXT_PUBLIC_SITE_URL="https://tudominio.com"

# --- Despliegue de UN SOLO proceso (cPanel / hosting con Node.js) ---
# Web y API en el mismo dominio: DEJA ESTAS DOS VACÍAS.
NEXT_PUBLIC_API_URL=""
API_URL=""
CORS_ORIGIN="https://tudominio.com"

# ==========================================================
#  (Opcional) Desarrollo local con DOS procesos: npm run dev
#  Si vas a usar `npm run dev`, comenta las dos líneas de arriba
#  (NEXT_PUBLIC_API_URL y API_URL) y descomenta estas:
# ==========================================================
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# NEXT_PUBLIC_API_URL="http://localhost:4000"
# API_URL="http://localhost:4000"
# CORS_ORIGIN="http://localhost:3000"
