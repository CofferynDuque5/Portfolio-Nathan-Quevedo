# ==========================================================
#  Portfolio Nathan Quevedo - Variables de entorno
#  Copia este archivo como `.env` y ajusta los valores.
# ==========================================================

# --- Base de datos (MySQL) ---
# Formato: mysql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="mysql://root:password@localhost:3306/portfolio_nathan"

# --- Servidor / API (Express) ---
PORT=4000
NODE_ENV=development

# URL pública del backend (usada por el frontend para consumir la API)
# En producción usa tu dominio, ej: https://api.tudominio.com
API_URL="http://localhost:4000"

# --- Seguridad / Autenticación ---
# Cambia OBLIGATORIAMENTE estos valores en producción
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"

# --- Administrador inicial (creado por el seed) ---
ADMIN_NAME="Nathan Quevedo"
ADMIN_EMAIL="admin@nathanquevedo.com"
ADMIN_PASSWORD="Admin1234!"

# --- Subida de archivos ---
UPLOAD_DIR="../web/public/uploads"
MAX_UPLOAD_MB=15

# --- CORS ---
CORS_ORIGIN="http://localhost:3000"

# ==========================================================
#  Frontend (Next.js) - estas se leen también desde /web
# ==========================================================
# URL del backend accesible desde el navegador (cliente)
NEXT_PUBLIC_API_URL="http://localhost:4000"
# URL canónica del sitio (para SEO / sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
