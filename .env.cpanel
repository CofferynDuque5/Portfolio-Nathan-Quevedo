# ==========================================================
#  .env listo para cPanel — Portfolio Nathan Quevedo
#  1) Renombra este archivo a  .env
#  2) Cambia SOLO la primera línea (DATABASE_URL) con los datos
#     de tu base de datos MySQL creada en cPanel.
#  El resto ya está configurado.
# ==========================================================

# >>> CAMBIA ESTA LÍNEA con tu USUARIO, CONTRASEÑA y NOMBRE de la BD <<<
# Formato: mysql://USUARIO:CONTRASENA@localhost:3306/NOMBRE_BD
DATABASE_URL="mysql://USUARIO:CONTRASENA@localhost:3306/NOMBRE_BD"

# --- Puerto (cPanel/Passenger lo asigna solo; puedes dejarlo así) ---
PORT=3000
NODE_ENV=production

# --- Seguridad ---
# Déjala vacía: la app genera sola una clave segura y la guarda en .jwt-secret.
# (Si pones una propia, que tenga al menos 32 caracteres al azar.)
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- URLs del sitio (un solo proceso: API y web en el mismo dominio) ---
NEXT_PUBLIC_SITE_URL="https://nathanquevedo.nvcorx.com"
NEXT_PUBLIC_API_URL=""
API_URL=""
CORS_ORIGIN="https://nathanquevedo.nvcorx.com"

# --- Subida de archivos (vacío = carpeta por defecto) ---
UPLOAD_DIR=""
MAX_UPLOAD_MB=15

# --- Administrador del panel /admin ---
# ADMIN_PASSWORD: escribe una contraseña propia (10 caracteres o más).
# Si la dejas vacía, al instalar se crea una al azar y se guarda en
# ADMIN-PASSWORD.txt (ábrelo, entra al panel, cámbiala y borra el archivo).
ADMIN_NAME="Nathan Quevedo"
ADMIN_EMAIL="admin@nathanquevedo.com"
ADMIN_PASSWORD=""
